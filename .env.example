BAYMAX_MODE=simulator
# Also supported: laptop, standalone, reachy (physical mode remains fail-closed).
BAYMAX_LLM_BACKEND=mock
BAYMAX_VOICE_MODE=mock
BAYMAX_FALLBACK_LLM_BACKEND=
BAYMAX_ASR_BACKEND=mock
BAYMAX_TTS_BACKEND=console
BAYMAX_ASR_EXECUTABLE=
BAYMAX_ASR_MODEL_PATH=
BAYMAX_TTS_EXECUTABLE=
BAYMAX_TTS_MODEL_PATH=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=30
OLLAMA_RETRIES=2
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_TEMPERATURE=0.2
BAYMAX_ALLOW_OLLAMA_LAN=false
LITERT_MODEL_PATH=
LITERT_MODEL_PROFILE=
DATABASE_PATH=./data/baymax.sqlite3
BAYMAX_SYSTEM_PROMPT=You are a calm, kind, concise local wellness companion. Be transparent about limitations.
BAYMAX_ROBOT_BACKEND=simulator
BAYMAX_CONFIRM_SUPERVISED=false
BAYMAX_PHYSICAL_CHECKLIST_COMPLETE=false
BAYMAX_REACHY_CONNECTION_MODE=local
BAYMAX_REACHY_CONNECTION_TIMEOUT=5
BAYMAX_REACHY_WATCHDOG_TIMEOUT=10
BAYMAX_REACHY_MAX_EXPRESSION_DURATION=3
BAYMAX_REACHY_MAX_MOVEMENT=0.25

# Laptop browser pipeline (empty means no silent LLM fallback)
BAYMAX_MODE=laptop
BAYMAX_LLM_BACKEND=ollama
BAYMAX_FALLBACK_LLM_BACKEND=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
BAYMAX_ASR_BACKEND=mock
BAYMAX_TTS_BACKEND=console
# For optional local voice:
# BAYMAX_ASR_BACKEND=faster-whisper
# ASR_MODEL_PATH=C:\BaymaxModels\faster-whisper-small
# BAYMAX_TTS_BACKEND=piper
# TTS_EXECUTABLE=C:\BaymaxTools\piper\piper.exe
# TTS_MODEL_PATH=C:\BaymaxModels\piper\en_US-lessac-medium.onnx
